.tab-bar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 22rpx;
  width: 100vw;
  padding-bottom: calc(env(safe-area-inset-bottom) + 8rpx);
  background: transparent;
  z-index: 999;
  pointer-events: none;
}

.tab-bar {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  height: 112rpx;
  margin: 0 24rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(29, 47, 74, 0.08);
  border-radius: 36rpx;
  box-shadow: 0 20rpx 46rpx rgba(31, 49, 82, 0.14);
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  position: relative;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  color: #7C8393;
}

.tab-item.active {
  color: #214B8F;
}

.tab-item__active-pill {
  position: absolute;
  inset: 6rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(33, 75, 143, 0.16), rgba(216, 142, 82, 0.14));
}

.tab-item__content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon-shell {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-text {
  font-size: 20rpx;
  margin-top: 6rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
