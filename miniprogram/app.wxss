/**
 * 亲健小程序 - 全局样式
 */

/* ===== CSS 变量 ===== */
page {
  /* 静谧纸本 + 深海蓝 */
  --color-primary: #214B8F;
  --color-primary-light: #4E78BC;
  --color-primary-bg: rgba(33, 75, 143, 0.09);
  --color-secondary: #D88E52;
  --color-accent: #7AA08F;
  --color-warm: #E9C7A3;
  --color-bg: #F6F1E8;
  --color-white: #FFFFFF;
  --color-text: #192234;
  --color-text-secondary: #4F596E;
  --color-text-muted: #7C8393;
  --color-border: rgba(25, 34, 52, 0.08);
  --color-danger: #D95C5C;
  --color-success: #2E8B72;
  --color-warning: #D9A14D;

  /* 扩展变量 */
  --color-cream-bg: #F8F4ED;
  --color-cream-card: rgba(255, 255, 255, 0.9);
  --color-cream-text: #192234;
  --color-cream-sub: #5C667A;
  --color-cream-accent: #214B8F;
  --color-cream-border: rgba(25, 34, 52, 0.08);
  --shadow-cream: 0 18rpx 44rpx rgba(27, 39, 63, 0.08);

  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-round: 999rpx;

  --shadow-sm: 0 8rpx 18rpx rgba(26, 36, 54, 0.04);
  --shadow-md: 0 14rpx 34rpx rgba(26, 36, 54, 0.08);
  --shadow-lg: 0 20rpx 46rpx rgba(26, 36, 54, 0.12);

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  --font-display: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;

  font-family: var(--font-body);
  font-size: 28rpx;
  color: var(--color-text);
  background:
    linear-gradient(180deg, #F6F1E8 0%, #EEF3FA 48%, #F8FAFC 100%);
  line-height: 1.6;
  overflow-x: hidden;
}

/* ===== 通用容器 ===== */
.container {
  padding: 28rpx 28rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
  position: relative;
}

.container-safe {
  padding-bottom: calc(248rpx + env(safe-area-inset-bottom));
}

.brand-ribbon {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.brand-ribbon__logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.brand-ribbon__copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-ribbon__eyebrow {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary);
}

.brand-ribbon__title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
}

/* ===== 卡片 ===== */
.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

.card-creamy {
  background: var(--color-cream-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-cream);
  border: 1rpx solid var(--color-cream-border);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
}

.card-creamy:active {
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-elevated {
  box-shadow: var(--shadow-md);
}

/* ===== 文字排版 ===== */
.text-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.25;
  font-family: var(--font-display);
}

.text-subtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  font-family: var(--font-display);
}

.text-body {
  font-size: 28rpx;
  color: var(--color-text);
}

.text-caption {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.text-small {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.text-primary {
  color: var(--color-primary);
}

.text-accent {
  color: var(--color-accent);
}

.text-danger {
  color: var(--color-danger);
}

.text-center {
  text-align: center;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--radius-round);
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  padding: 0 48rpx;
  transition: opacity 0.2s, transform 0.1s;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(33, 75, 143, 0.2);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.84);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid rgba(33, 75, 143, 0.2);
}

.btn-accent {
  background: linear-gradient(135deg, var(--color-secondary), #E3B47F);
  color: #ffffff;
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
}

.btn-small {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 输入框 ===== */
.input-wrap {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-lg);
  border: 1rpx solid var(--color-border);
  transition: border-color 0.2s;
}

.input-wrap-focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2rpx rgba(91, 141, 238, 0.08);
  background: var(--color-white);
}

.input-wrap input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--color-text);
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-round);
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.tag-accent {
  background: rgba(255, 154, 118, 0.12);
  color: var(--color-accent);
}

.tag-success {
  background: rgba(0, 184, 148, 0.1);
  color: var(--color-success);
}

.tag-warning {
  background: rgba(253, 203, 110, 0.15);
  color: #E17055;
}

.tag-danger {
  background: rgba(255, 107, 107, 0.1);
  color: var(--color-danger);
}

/* ===== 布局辅助 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.gap-xs { gap: var(--spacing-xs); }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }
.gap-lg { gap: var(--spacing-lg); }

/* ===== 间距辅助 ===== */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: var(--spacing-md) 0;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-state-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.4;
}

.empty-state-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

/* ===== 渐变装饰 ===== */
.gradient-header {
  background: var(--color-primary);
  color: #ffffff;
  padding: var(--spacing-xl) var(--spacing-lg);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
}

.gradient-card {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: none;
}

.editorial-line {
  width: 96rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

/* ===== 动画 ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(91, 141, 238, 0.12); }
  50% { box-shadow: 0 0 0 12rpx rgba(91, 141, 238, 0); }
}

@keyframes splashFadeOut {
  0% { opacity: 1; visibility: visible; }
  80% { opacity: 1; visibility: visible; }
  100% { opacity: 0; visibility: hidden; }
}

@keyframes splashZoom {
  0% { transform: scale(0.9); opacity: 0; }
  20% { transform: scale(1); opacity: 1; }
  80% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.1); opacity: 0; }
}

.animate-fade-in {
  animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* 分组与列表 */
.section-block {
  background: rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  border: 1rpx solid var(--color-border);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.section-block__title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.section-block__subtitle {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.cell-list {
  overflow: hidden;
}

.cell-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.cell-row + .cell-row {
  border-top: 1rpx solid #f0f1f3;
}

.cell-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.cell-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(33, 75, 143, 0.08), rgba(216, 142, 82, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.cell-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cell-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.cell-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.cell-value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 600;
}

.cell-arrow {
  font-size: 32rpx;
  color: #C5CBD3;
  margin-left: 16rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 245, 229, 0.98), rgba(255, 252, 245, 0.9));
  border: 1rpx solid rgba(217, 161, 77, 0.22);
  border-radius: 24rpx;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.notice-bar__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.notice-icon {
  font-size: 32rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #9A6700;
}

.notice-desc {
  font-size: 22rpx;
  color: #B07A18;
  margin-top: 4rpx;
}

/* 启动屏 Splash */
.splash-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #F5EEE2 0%, #EEF3FA 100%);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: splashFadeOut 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  pointer-events: none;
}

.splash-logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 36rpx rgba(33, 75, 143, 0.16);
  margin-bottom: 40rpx;
  animation: splashZoom 2.0s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.splash-text {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 2rpx;
  animation: splashZoom 2.0s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.1s;
}

.splash-sub {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 16rpx;
  animation: splashZoom 2.0s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.2s;
}
