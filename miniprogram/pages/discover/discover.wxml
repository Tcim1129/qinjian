<view class="discover-container container-safe animate-fade-in">
  <view class="discover-hero">
    <view class="discover-hero__top">
      <view>
        <view class="discover-hero__eyebrow">ASSESSMENT HUB</view>
        <view class="discover-hero__title">关系体检与 AI 支持入口</view>
        <view class="discover-hero__desc">这里更像系统主链的中枢，不是内容广场。先做正式体检，再回到报告和时间轴看变化。</view>
      </view>
      <view class="discover-hero__actions">
        <view class="icon-btn" bindtap="goCheckin">✍</view>
        <view class="icon-btn" bindtap="goProfile">🙂</view>
      </view>
    </view>

    <view class="hero-action-grid">
      <view
        wx:for="{{heroActions}}"
        wx:key="id"
        class="hero-action-card"
        bindtap="openPath"
        data-path="{{item.path}}"
        data-istab="{{item.isTab}}"
      >
        <view class="hero-action-card__icon">{{item.icon}}</view>
        <view class="hero-action-card__title">{{item.title}}</view>
        <view class="hero-action-card__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section-block discover-section">
    <view class="section-block__title">专项赛主链能力</view>
    <view class="capability-list">
      <view
        wx:for="{{coreModules}}"
        wx:key="id"
        class="capability-card"
        bindtap="openPath"
        data-path="{{item.path}}"
      >
        <view class="capability-card__icon">{{item.icon}}</view>
        <view class="capability-card__copy">
          <view class="capability-card__title">{{item.title}}</view>
          <view class="capability-card__desc">{{item.desc}}</view>
        </view>
        <view class="capability-card__arrow">›</view>
      </view>
    </view>
  </view>

  <view class="section-block discover-section">
    <view class="section-block__title">延伸支持模块</view>
    <view class="support-grid">
      <view
        wx:for="{{supportModules}}"
        wx:key="id"
        class="support-card"
        bindtap="openPath"
        data-path="{{item.path}}"
      >
        <view class="support-card__icon">{{item.icon}}</view>
        <view class="support-card__title">{{item.title}}</view>
        <view class="support-card__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>
