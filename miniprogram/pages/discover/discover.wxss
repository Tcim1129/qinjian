.discover-container {
  padding: 24rpx 28rpx 40rpx;
  min-height: 100vh;
}

.discover-hero {
  padding: 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.92), rgba(239, 244, 251, 0.86));
  border: 1rpx solid rgba(25, 34, 52, 0.08);
  box-shadow: 0 20rpx 42rpx rgba(26, 36, 54, 0.08);
}

.discover-hero__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.discover-hero__eyebrow {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-muted);
}

.discover-hero__title {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 800;
  color: var(--color-text);
}

.discover-hero__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

.discover-hero__actions {
  display: flex;
  gap: 12rpx;
}

.icon-btn {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(25, 34, 52, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 10rpx 22rpx rgba(26, 36, 54, 0.08);
}

.hero-action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.hero-action-card {
  min-height: 220rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(33, 75, 143, 0.1), rgba(255, 255, 255, 0.82));
  border: 1rpx solid rgba(33, 75, 143, 0.1);
}

.hero-action-card__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.hero-action-card__title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
}

.hero-action-card__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.discover-section {
  margin-top: 24rpx;
}

.capability-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.capability-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(247, 249, 252, 0.9);
}

.capability-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  box-shadow: 0 10rpx 20rpx rgba(26, 36, 54, 0.08);
}

.capability-card__copy {
  flex: 1;
  min-width: 0;
}

.capability-card__title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
}

.capability-card__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.capability-card__arrow {
  font-size: 32rpx;
  color: #B4BCCB;
}

.support-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.support-card {
  min-height: 210rpx;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(246, 241, 232, 0.8));
  border: 1rpx solid rgba(25, 34, 52, 0.08);
}

.support-card__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(33, 75, 143, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.support-card__title {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
}

.support-card__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}
