<!-- 首页 - 比赛主链主页 -->
<view class="splash-screen">
  <image class="splash-logo" src="../../images/brand-logo.jpg" mode="aspectFit"></image>
  <view class="splash-text">亲健</view>
  <view class="splash-sub">把关系慢慢照顾好</view>
</view>

<view class="container container-safe home-page">
  <view class="home-hero">
    <view class="hero-glow hero-glow--one"></view>
    <view class="hero-glow hero-glow--two"></view>

    <view class="hero-brand-row">
      <view class="brand-ribbon">
        <image class="brand-ribbon__logo" src="../../images/brand-logo.jpg" mode="aspectFit"></image>
        <view class="brand-ribbon__copy">
          <view class="brand-ribbon__eyebrow">QINJIAN AI</view>
          <view class="brand-ribbon__title">青年亲密关系健康支持</view>
        </view>
      </view>
      <view class="hero-badge">AI 主链</view>
    </view>

    <view class="hero-greeting">{{greeting}}</view>
    <view class="hero-subtitle">把记录、体检、报告和时间轴串成一条更清楚的关系主线。</view>

    <view class="hero-chip-row">
      <view class="hero-chip" bindtap="goPair" wx:if="{{pairInfo}}">已配对 · 与 {{pairDisplayName}} 同行</view>
      <view class="hero-chip" bindtap="goPair" wx:else>单人模式 · 去建立双人空间</view>
      <view class="hero-chip hero-chip--soft" wx:if="{{hasCheckedIn}}">今日已记录</view>
      <view class="hero-chip hero-chip--soft" wx:else>今日待记录</view>
    </view>

    <view class="hero-action-grid">
      <view class="hero-action hero-action--primary" bindtap="goCheckin">
        <view class="hero-action__eyebrow">Daily Signal</view>
        <view class="hero-action__title">今天记录一下</view>
        <view class="hero-action__desc">把今天的互动和情绪留进时间轴。</view>
      </view>
      <view class="hero-action hero-action--secondary" bindtap="goHealthTest">
        <view class="hero-action__eyebrow">Weekly Review</view>
        <view class="hero-action__title">做一次关系体检</view>
        <view class="hero-action__desc">正式提交本周状态，让报告更稳。</view>
      </view>
    </view>

    <view class="hero-metric-grid">
      <view class="hero-metric">
        <view class="hero-metric__value">{{streak}}</view>
        <view class="hero-metric__label">连续记录</view>
      </view>
      <view class="hero-metric">
        <view class="hero-metric__value">{{latestAssessment ? latestAssessment.totalScore : '--'}}</view>
        <view class="hero-metric__label">最新体检</view>
      </view>
      <view class="hero-metric">
        <view class="hero-metric__value">{{latestReport ? latestReport.healthScore : '--'}}</view>
        <view class="hero-metric__label">最新报告</view>
      </view>
    </view>
  </view>

  <view class="notice-bar" wx:if="{{hasCrisis}}" bindtap="goCrisis">
    <view class="notice-bar__left">
      <text class="notice-icon">⚠</text>
      <view>
        <view class="notice-title">关系预警提醒</view>
        <view class="notice-desc">{{crisisStatus.message || '系统识别到关系波动，建议优先查看安全提示。'}}</view>
      </view>
    </view>
    <text class="cell-arrow">›</text>
  </view>

  <view class="section-block home-section">
    <view class="section-block__title">继续你的主线</view>
    <view class="home-flow-list">
      <view class="flow-card" bindtap="goReport">
        <view class="flow-card__icon">📊</view>
        <view class="flow-card__title">打开报告</view>
        <view class="flow-card__desc">{{latestReport ? latestReport.insight : '查看最近一次系统判断与建议。'}}</view>
      </view>
      <view class="flow-card" bindtap="goTimeline">
        <view class="flow-card__icon">🕒</view>
        <view class="flow-card__title">回看时间轴</view>
        <view class="flow-card__desc">把记录、体检和报告串回真实发生的过程。</view>
      </view>
      <view class="flow-card" bindtap="goPrivacy">
        <view class="flow-card__icon">🔒</view>
        <view class="flow-card__title">检查隐私边界</view>
        <view class="flow-card__desc">确认数据权限、沙盒模式与删除请求状态。</view>
      </view>
    </view>
  </view>

  <view class="section-block home-section" wx:if="{{latestAssessment || latestReport}}">
    <view class="section-block__title">系统快照</view>
    <view class="snapshot-grid">
      <view class="snapshot-card" wx:if="{{latestAssessment}}">
        <view class="snapshot-card__label">本周体检</view>
        <view class="snapshot-card__score">{{latestAssessment.totalScore}}</view>
        <view class="snapshot-card__desc">{{latestAssessment.levelLabel}}</view>
      </view>
      <view class="snapshot-card" wx:if="{{latestReport}}">
        <view class="snapshot-card__label">{{latestReport.title}}</view>
        <view class="snapshot-card__score">{{latestReport.healthScore}}</view>
        <view class="snapshot-card__desc">{{latestReport.insight}}</view>
      </view>
    </view>
  </view>

  <view class="section-block home-section" wx:if="{{hasCheckedIn && todayCheckin}}">
    <view class="section-block__title">今日记录摘要</view>
    <view class="daily-summary">
      <view class="daily-summary__row">
        <text class="daily-summary__label">心情评分</text>
        <text class="daily-summary__value">{{todayCheckin.mood_score || 0}} / 4</text>
      </view>
      <view class="daily-summary__row">
        <text class="daily-summary__label">互动次数</text>
        <text class="daily-summary__value">{{todayCheckin.interaction_freq || 0}} 次</text>
      </view>
      <view class="daily-summary__row">
        <text class="daily-summary__label">深度交流</text>
        <text class="daily-summary__value">{{todayCheckin.deep_conversation ? '有' : '无'}}</text>
      </view>
      <view class="daily-summary__note" wx:if="{{todayCheckin.content}}">{{todayCheckin.content}}</view>
    </view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="text-caption">正在同步首页状态...</text>
  </view>
</view>
