.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border-radius: 40rpx;
  background:
    linear-gradient(145deg, rgba(18, 40, 78, 0.96), rgba(39, 72, 126, 0.92));
  box-shadow: 0 24rpx 52rpx rgba(20, 37, 69, 0.22);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  opacity: 0.75;
}

.hero-glow--one {
  width: 280rpx;
  height: 280rpx;
  top: -80rpx;
  right: -60rpx;
  background: rgba(122, 160, 143, 0.34);
}

.hero-glow--two {
  width: 220rpx;
  height: 220rpx;
  left: -90rpx;
  bottom: -110rpx;
  background: rgba(216, 142, 82, 0.22);
}

.hero-brand-row,
.hero-greeting,
.hero-subtitle,
.hero-chip-row,
.hero-action-grid,
.hero-metric-grid {
  position: relative;
  z-index: 1;
}

.hero-brand-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-brand-row .brand-ribbon__eyebrow,
.hero-brand-row .brand-ribbon__title {
  color: #F8F4EC;
}

.hero-brand-row .brand-ribbon__eyebrow {
  opacity: 0.72;
  letter-spacing: 3rpx;
  font-size: 18rpx;
}

.hero-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #F6E5D0;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-greeting {
  margin-top: 30rpx;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #FFFFFF;
}

.hero-subtitle {
  margin-top: 18rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(244, 247, 252, 0.78);
}

.hero-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #F5F7FC;
  font-size: 21rpx;
}

.hero-chip--soft {
  background: rgba(216, 142, 82, 0.2);
  color: #F8E5D0;
}

.hero-action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-action {
  min-height: 196rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-action--primary {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.12));
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.hero-action--secondary {
  background: linear-gradient(180deg, rgba(216, 142, 82, 0.26), rgba(216, 142, 82, 0.14));
  border: 1rpx solid rgba(255, 226, 197, 0.18);
}

.hero-action__eyebrow {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: rgba(248, 244, 236, 0.7);
}

.hero-action__title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.hero-action__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(245, 247, 252, 0.78);
}

.hero-metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.hero-metric {
  padding: 18rpx 10rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
  text-align: center;
}

.hero-metric__value {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
  color: #FFFFFF;
}

.hero-metric__label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(245, 247, 252, 0.7);
}

.home-section {
  padding: 28rpx;
}

.home-flow-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.flow-card {
  min-height: 188rpx;
  padding: 24rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(33, 75, 143, 0.06), rgba(255, 255, 255, 0.72));
  border: 1rpx solid rgba(33, 75, 143, 0.08);
}

.flow-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  box-shadow: 0 10rpx 24rpx rgba(25, 34, 52, 0.08);
}

.flow-card__title {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
}

.flow-card__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.snapshot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.snapshot-card {
  min-height: 180rpx;
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 249, 252, 0.9));
  border: 1rpx solid rgba(25, 34, 52, 0.08);
}

.snapshot-card__label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-muted);
}

.snapshot-card__score {
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
  color: var(--color-primary);
}

.snapshot-card__desc {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.daily-summary {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.daily-summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(25, 34, 52, 0.08);
}

.daily-summary__row:last-of-type {
  border-bottom: none;
}

.daily-summary__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.daily-summary__value {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 700;
}

.daily-summary__note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(33, 75, 143, 0.06);
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}
