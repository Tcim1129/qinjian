<view class="login-page">
  <view class="login-ambient login-ambient-primary"></view>
  <view class="login-ambient login-ambient-secondary"></view>

  <view class="login-shell">
    <view class="login-hero">
      <view class="login-hero__badge">QINJIAN AI</view>
      <image class="login-logo" src="../../images/brand-logo.jpg" mode="aspectFit"></image>
      <view class="login-title">进入亲健，继续你的关系主线</view>
      <view class="login-slogan">记录、体检、报告、时间轴会在登录后自动接续。</view>

      <view class="login-highlights">
        <view class="login-highlight">
          <view class="login-highlight__value">记录</view>
          <view class="login-highlight__label">留下日常信号</view>
        </view>
        <view class="login-highlight">
          <view class="login-highlight__value">体检</view>
          <view class="login-highlight__label">形成正式评估</view>
        </view>
        <view class="login-highlight">
          <view class="login-highlight__value">报告</view>
          <view class="login-highlight__label">得到系统判断</view>
        </view>
      </view>
    </view>

    <view class="login-panel">
      <view class="login-tabs-creamy">
        <view
          class="login-tab-creamy {{currentTab === 'login' ? 'active' : ''}}"
          bindtap="switchTab"
          data-tab="login"
        >登录</view>
        <view
          class="login-tab-creamy {{currentTab === 'register' ? 'active' : ''}}"
          bindtap="switchTab"
          data-tab="register"
        >注册</view>
      </view>

      <view class="login-form" wx:if="{{currentTab === 'login'}}">
        <view class="panel-head">
          <view class="panel-head__title">继续回到你的关系档案</view>
          <view class="panel-head__desc">支持邮箱、手机号和微信快速登录。</view>
        </view>

        <view wx:if="{{savedAccounts.length > 0 && !showAllLoginModes}}" class="saved-accounts">
          <view class="card-title mb-md">最近使用的账号</view>
          <view class="account-list">
            <block wx:for="{{savedAccounts}}" wx:key="email">
              <view class="account-item" bindtap="selectSavedAccount" data-account="{{item}}">
                <view class="account-info">
                  <view class="account-name">{{item.nickname || item.email}}</view>
                  <view class="account-email">{{item.email}}</view>
                </view>
                <view class="account-arrow">›</view>
              </view>
            </block>
          </view>
          <view class="divider mt-lg mb-lg"></view>
          <button class="btn btn-ghost btn-block" bindtap="showOtherLoginOptions">使用其他方式登录</button>
        </view>

        <view wx:if="{{savedAccounts.length === 0 || showAllLoginModes}}">
          <view class="mode-tabs">
            <view class="mode-tab {{loginMode === 'email' ? 'active' : ''}}" data-mode="email" bindtap="switchLoginMode">邮箱登录</view>
            <view class="mode-tab {{loginMode === 'phone' ? 'active' : ''}}" data-mode="phone" bindtap="switchLoginMode">手机登录</view>
          </view>

          <view wx:if="{{loginMode === 'email'}}">
            <view class="input-wrap mb-md">
              <input placeholder="邮箱" value="{{loginEmail}}" bindinput="onLoginEmailInput" />
            </view>

            <view class="input-wrap mb-md">
              <input placeholder="密码" password="{{!showLoginPwd}}" value="{{loginPassword}}" bindinput="onLoginPasswordInput" />
              <text class="pwd-toggle" bindtap="toggleLoginPwd">{{showLoginPwd ? '隐藏' : '显示'}}</text>
            </view>

            <view class="login-switch-row">
              <view class="toggle-line" bindtap="toggleRememberMe">
                <text class="checkbox {{rememberMe ? 'checked' : ''}}">{{rememberMe ? '已勾选' : '未勾选'}}</text>
                <text class="checkbox-label">记住账号</text>
              </view>
              <view class="toggle-line" bindtap="toggleAutoLogin">
                <text class="checkbox {{autoLogin ? 'checked' : ''}}">{{autoLogin ? '已开启' : '未开启'}}</text>
                <text class="checkbox-label">自动进入</text>
              </view>
            </view>

            <button
              class="btn btn-primary btn-block mt-lg {{submitting ? 'btn-disabled' : ''}}"
              bindtap="handleLogin"
              disabled="{{submitting}}"
            >
              {{submitting ? '登录中...' : '登录并继续'}}
            </button>
          </view>

          <view wx:else>
            <view class="input-wrap mb-md">
              <input placeholder="手机号" value="{{loginPhone}}" bindinput="onLoginPhoneInput" />
            </view>
            <view class="input-wrap mb-md">
              <input placeholder="验证码" value="{{loginCode}}" bindinput="onLoginCodeInput" />
              <text class="code-btn" bindtap="sendPhoneCode">获取验证码</text>
            </view>
            <button
              class="btn btn-primary btn-block mt-lg {{submitting ? 'btn-disabled' : ''}}"
              bindtap="handleLogin"
              disabled="{{submitting}}"
            >
              {{submitting ? '登录中...' : '登录并继续'}}
            </button>
          </view>

          <view class="divider mt-lg"></view>
          <button class="btn btn-secondary btn-block" bindtap="handleWechatLogin" disabled="{{submitting}}">
            微信快速登录
          </button>
        </view>
      </view>

      <view class="login-form" wx:if="{{currentTab === 'register'}}">
        <view class="panel-head">
          <view class="panel-head__title">创建你的关系支持空间</view>
          <view class="panel-head__desc">注册后就可以开始记录、体检和生成报告。</view>
        </view>

        <view class="mode-tabs">
          <view class="mode-tab {{regMode === 'email' ? 'active' : ''}}" data-mode="email" bindtap="switchRegMode">邮箱注册</view>
          <view class="mode-tab {{regMode === 'phone' ? 'active' : ''}}" data-mode="phone" bindtap="switchRegMode">手机注册</view>
        </view>

        <view wx:if="{{regMode === 'email'}}">
          <view class="input-wrap mb-md">
            <input placeholder="邮箱" value="{{regEmail}}" bindinput="onRegEmailInput" />
          </view>

          <view class="input-wrap mb-md">
            <input placeholder="密码（至少8位）" password="{{!showRegPwd}}" value="{{regPassword}}" bindinput="onRegPasswordInput" />
            <text class="pwd-toggle" bindtap="toggleRegPwd">{{showRegPwd ? '隐藏' : '显示'}}</text>
          </view>

          <view class="input-wrap mb-md">
            <input placeholder="确认密码" password="{{!showRegPwd}}" value="{{regPasswordConfirm}}" bindinput="onRegPasswordConfirmInput" />
          </view>

          <view class="input-wrap mb-md">
            <input placeholder="昵称" value="{{regNickname}}" bindinput="onRegNicknameInput" />
          </view>

          <button
            class="btn btn-primary btn-block mt-lg {{submitting ? 'btn-disabled' : ''}}"
            bindtap="handleRegister"
            disabled="{{submitting}}"
          >
            {{submitting ? '注册中...' : '注册并开始'}}
          </button>
        </view>

        <view wx:else>
          <view class="input-wrap mb-md">
            <input placeholder="手机号" value="{{regPhone}}" bindinput="onRegPhoneInput" />
          </view>
          <view class="input-wrap mb-md">
            <input placeholder="验证码" value="{{regCode}}" bindinput="onRegCodeInput" />
            <text class="code-btn" bindtap="sendRegPhoneCode">获取验证码</text>
          </view>
          <view class="input-wrap mb-md">
            <input placeholder="昵称" value="{{regNickname}}" bindinput="onRegNicknameInput" />
          </view>
          <button
            class="btn btn-primary btn-block mt-lg {{submitting ? 'btn-disabled' : ''}}"
            bindtap="handleRegister"
            disabled="{{submitting}}"
          >
            {{submitting ? '注册中...' : '注册并开始'}}
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
