.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #F5EEE2 0%, #EEF3FA 100%);
}

.login-ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(20px);
  opacity: 0.9;
  pointer-events: none;
}

.login-ambient-primary {
  width: 260rpx;
  height: 260rpx;
  top: 60rpx;
  left: -100rpx;
  background: rgba(33, 75, 143, 0.08);
}

.login-ambient-secondary {
  width: 240rpx;
  height: 240rpx;
  top: 200rpx;
  right: -120rpx;
  background: rgba(216, 142, 82, 0.08);
}

.login-shell {
  position: relative;
  z-index: 1;
  padding: 70rpx 28rpx 48rpx;
}

.login-hero {
  padding: 34rpx 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(150deg, rgba(18, 40, 78, 0.96), rgba(39, 72, 126, 0.92));
  box-shadow: 0 24rpx 52rpx rgba(20, 37, 69, 0.2);
  text-align: center;
}

.login-hero__badge {
  display: inline-flex;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #F7E9D3;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.login-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.12);
}

.login-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #FFFFFF;
}

.login-slogan {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(245, 247, 252, 0.76);
}

.login-highlights {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.login-highlight {
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
}

.login-highlight__value {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.login-highlight__label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(245, 247, 252, 0.68);
}

.login-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(25, 34, 52, 0.08);
  box-shadow: 0 16rpx 36rpx rgba(26, 36, 54, 0.08);
}

.login-tabs-creamy {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: rgba(33, 75, 143, 0.05);
  border-radius: 20rpx;
}

.login-tab-creamy {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  color: var(--color-text-secondary);
  font-weight: 700;
}

.login-tab-creamy.active {
  background: #FFFFFF;
  color: var(--color-primary);
  box-shadow: 0 10rpx 18rpx rgba(26, 36, 54, 0.08);
}

.login-form {
  margin-top: 24rpx;
}

.panel-head {
  margin-bottom: 20rpx;
}

.panel-head__title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
}

.panel-head__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.mode-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(33, 75, 143, 0.05);
  margin-bottom: 20rpx;
}

.mode-tab {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

.mode-tab.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
}

.input-wrap {
  background: rgba(247, 249, 252, 0.9);
  border: 1rpx solid rgba(25, 34, 52, 0.08);
}

.code-btn,
.pwd-toggle {
  font-size: 24rpx;
  color: var(--color-primary);
  padding-left: 16rpx;
  font-weight: 700;
}

.divider {
  height: 1rpx;
  background: rgba(25, 34, 52, 0.08);
  margin: 32rpx 0;
}

.login-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.toggle-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.checkbox {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.checkbox.checked {
  color: var(--color-primary);
}

.checkbox-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.saved-accounts {
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
}

.account-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.account-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: rgba(247, 249, 252, 0.9);
  border-radius: 22rpx;
  border: 1rpx solid rgba(25, 34, 52, 0.08);
}

.account-item:active {
  background: rgba(33, 75, 143, 0.08);
}

.account-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.account-email {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.account-arrow {
  font-size: 36rpx;
  color: var(--color-text-muted);
}
