.report-page {
  padding-top: 24rpx;
}

.loading-shell,
.empty-shell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(33, 75, 143, 0.14);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.report-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.report-hero {
  padding: 34rpx 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(150deg, rgba(18, 40, 78, 0.96), rgba(39, 72, 126, 0.92));
  box-shadow: 0 24rpx 52rpx rgba(20, 37, 69, 0.2);
}

.report-hero__top,
.report-score-row,
.report-hero__insight,
.report-hero__suggestion,
.report-hero__actions {
  position: relative;
}

.report-hero__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.report-hero__eyebrow {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: rgba(245, 247, 252, 0.66);
}

.report-hero__title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.report-hero__date {
  font-size: 20rpx;
  color: rgba(245, 247, 252, 0.66);
  text-align: right;
}

.report-score-row {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  margin-top: 28rpx;
}

.score-number {
  font-size: 82rpx;
  font-weight: 900;
  line-height: 1;
  color: #FFFFFF;
}

.score-unit {
  font-size: 24rpx;
  color: rgba(245, 247, 252, 0.72);
  padding-bottom: 10rpx;
}

.report-hero__insight {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(245, 247, 252, 0.88);
}

.report-hero__suggestion {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
}

.suggestion-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(245, 247, 252, 0.6);
  margin-bottom: 8rpx;
}

.suggestion-text {
  font-size: 24rpx;
  line-height: 1.75;
  color: #FFFFFF;
}

.report-hero__actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.report-action {
  padding: 18rpx 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
}

.report-action__title {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.report-action__desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: rgba(245, 247, 252, 0.72);
}

.segment-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(25, 34, 52, 0.08);
}

.segment-tabs__item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-muted);
  border-radius: 18rpx;
}

.segment-tabs__item.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  box-shadow: 0 10rpx 20rpx rgba(33, 75, 143, 0.16);
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.content-card {
  border-radius: 28rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(25, 34, 52, 0.08);
  box-shadow: 0 12rpx 28rpx rgba(26, 36, 54, 0.06);
}

.content-card--warn {
  border-color: rgba(217, 161, 77, 0.2);
}

.content-card--border {
  border-color: rgba(33, 75, 143, 0.14);
}

.content-card__title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.bullet-list {
  display: flex;
  flex-direction: column;
}

.bullet-item {
  padding: 12rpx 0;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
  border-bottom: 1rpx solid rgba(25, 34, 52, 0.08);
}

.bullet-item:last-child {
  border-bottom: none;
}

.safety-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.safety-pill {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(216, 142, 82, 0.16);
  color: #A8632B;
  font-size: 18rpx;
  font-weight: 700;
}

.safety-why {
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.evidence-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.evidence-chip {
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(33, 75, 143, 0.06);
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.content-card__note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(33, 75, 143, 0.06);
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.content-card__alert {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(217, 92, 92, 0.12);
  color: #8A3B2F;
  font-size: 22rpx;
  line-height: 1.7;
}

.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 12rpx;
  gap: 20rpx;
}

.trend-score {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--color-primary);
  line-height: 1;
}

.trend-desc {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  text-align: right;
}

.trend-points,
.dimension-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.trend-point,
.dimension-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(33, 75, 143, 0.05);
}

.trend-point__label,
.dimension-item__label {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.trend-point__score,
.dimension-item__score {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-top: 6rpx;
}

.trend-point__summary {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}

.dimension-meter {
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: rgba(33, 75, 143, 0.12);
  overflow: hidden;
}

.dimension-meter__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
}

.history-section {
  margin-top: 4rpx;
}

.history-section__title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.history-section__empty {
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-align: center;
  padding: 32rpx 0;
}

.history-list {
  padding: 0 6rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(25, 34, 52, 0.08);
}

.history-item:last-child {
  border-bottom: none;
}

.history-item__info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.history-item__title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text);
}

.history-item__date {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.history-item__arrow {
  font-size: 32rpx;
  color: #B4BCCB;
}
