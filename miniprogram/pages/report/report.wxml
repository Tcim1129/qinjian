<view class="container container-safe report-page">
  <view class="loading-shell" wx:if="{{loading && !reportView}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在整理报告...</view>
  </view>

  <view class="empty-shell" wx:if="{{!loading && !reportView}}">
    <view class="empty-icon">📋</view>
    <view class="empty-title">还没有可查看的报告</view>
    <view class="empty-desc">先完成记录或正式体检，系统才会生成更稳定的判断。</view>
    <button class="btn btn-primary btn-block" bindtap="goCheckin">先去记录</button>
  </view>

  <view wx:if="{{reportView}}" class="report-body">
    <view class="report-hero">
      <view class="report-hero__top">
        <view>
          <view class="report-hero__eyebrow">RELATION REPORT</view>
          <view class="report-hero__title">{{reportView.title || '关系报告'}}</view>
        </view>
        <view class="report-hero__date">{{reportContent.report_date || reportContent.created_at || ''}}</view>
      </view>

      <view class="report-score-row">
        <view class="score-number">{{reportView.healthScore !== null && reportView.healthScore !== undefined ? reportView.healthScore : '--'}}</view>
        <view class="score-unit">/ 100</view>
      </view>

      <view class="report-hero__insight" wx:if="{{reportView.insight}}">{{reportView.insight}}</view>

      <view class="report-hero__suggestion" wx:if="{{reportView.suggestion}}">
        <view class="suggestion-label">下一步建议</view>
        <view class="suggestion-text">{{reportView.suggestion}}</view>
      </view>

      <view class="report-hero__actions">
        <view class="report-action" bindtap="openAction" data-path="/pages/discover/discover">
          <view class="report-action__title">去体检</view>
          <view class="report-action__desc">继续补充正式评估</view>
        </view>
        <view class="report-action" bindtap="openAction" data-path="/pages/timeline/timeline">
          <view class="report-action__title">看时间轴</view>
          <view class="report-action__desc">回到真实过程里</view>
        </view>
      </view>
    </view>

    <view class="segment-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="segment-tabs__item {{currentTab === item.key ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="{{item.key}}"
      >{{item.label}}</view>
    </view>

    <view class="content-grid" wx:if="{{reportView.highlights.length || reportView.concerns.length}}">
      <view class="content-card" wx:if="{{reportView.highlights.length}}">
        <view class="content-card__title">关系亮点</view>
        <view class="bullet-list">
          <view class="bullet-item" wx:for="{{reportView.highlights}}" wx:key="*this">{{item}}</view>
        </view>
      </view>
      <view class="content-card content-card--warn" wx:if="{{reportView.concerns.length}}">
        <view class="content-card__title">关注点</view>
        <view class="bullet-list">
          <view class="bullet-item" wx:for="{{reportView.concerns}}" wx:key="*this">{{item}}</view>
        </view>
      </view>
    </view>

    <view class="content-card content-card--border" wx:if="{{safetyStatus}}">
      <view class="content-card__title">安全边界</view>
      <view class="safety-row">
        <view class="safety-pill">{{safetyStatus.risk_level || 'low'}}</view>
        <view class="safety-why">{{safetyStatus.why_now}}</view>
      </view>
      <view class="evidence-list" wx:if="{{safetyStatus.evidence_summary && safetyStatus.evidence_summary.length}}">
        <view class="evidence-chip" wx:for="{{safetyStatus.evidence_summary}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="content-card__note" wx:if="{{reportView.limitationNote || safetyStatus.limitation_note}}">
        {{reportView.limitationNote || safetyStatus.limitation_note}}
      </view>
      <view class="content-card__alert" wx:if="{{reportView.safetyHandoff || safetyStatus.handoff_recommendation}}">
        {{reportView.safetyHandoff || safetyStatus.handoff_recommendation}}
      </view>
    </view>

    <view class="content-card" wx:if="{{assessmentTrend}}">
      <view class="content-card__title">近 4 次体检趋势</view>
      <view class="trend-head">
        <view class="trend-score">{{assessmentTrend.latestScore || '--'}}</view>
        <view class="trend-desc">{{assessmentTrend.changeSummary}}</view>
      </view>
      <view class="trend-points" wx:if="{{assessmentTrend.points.length}}">
        <view class="trend-point" wx:for="{{assessmentTrend.points}}" wx:key="id">
          <view class="trend-point__label">{{item.label}}</view>
          <view class="trend-point__score">{{item.score}}</view>
          <view class="trend-point__summary">{{item.summary}}</view>
        </view>
      </view>
      <view class="dimension-grid" wx:if="{{assessmentTrend.dimensions.length}}">
        <view class="dimension-item" wx:for="{{assessmentTrend.dimensions}}" wx:key="id">
          <view class="dimension-item__label">{{item.label}}</view>
          <view class="dimension-item__score">{{item.score}}</view>
          <view class="dimension-meter">
            <view class="dimension-meter__fill" style="width: {{item.score || 0}}%;"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="history-section">
      <view class="history-section__title">历史报告</view>
      <view class="history-list" wx:if="{{historyListView.length}}">
        <view
          class="history-item"
          wx:for="{{historyListView}}"
          wx:key="id"
          bindtap="viewReport"
          data-report="{{item}}"
        >
          <view class="history-item__info">
            <view class="history-item__title">{{item._label || '报告'}}</view>
            <view class="history-item__date">{{item.created_at || item.report_date || ''}}</view>
          </view>
          <view class="history-item__arrow">›</view>
        </view>
      </view>
      <view class="history-section__empty" wx:else>暂无历史报告</view>
    </view>
  </view>
</view>
