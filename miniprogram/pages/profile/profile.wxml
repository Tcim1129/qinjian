<view class="container container-safe profile-page">
  <view class="profile-hero">
    <view class="profile-hero__orb"></view>
    <view class="profile-hero__content">
      <view class="profile-avatar">{{userInfo && userInfo.nickname ? userInfo.nickname[0] : '亲'}}</view>
      <view class="profile-info">
        <view class="profile-name">{{userInfo && userInfo.nickname ? userInfo.nickname : '亲健用户'}}</view>
        <view class="profile-meta">{{userInfo && (userInfo.email || userInfo.phone) ? (userInfo.email || userInfo.phone) : '登录后同步关系状态'}}</view>
      </view>
      <view class="profile-status {{isPaired ? 'paired' : 'single'}}">{{isPaired ? '已配对' : '单人模式'}}</view>
    </view>

    <view class="profile-summary-grid">
      <view class="profile-summary-card">
        <view class="profile-summary-card__label">关系状态</view>
        <view class="profile-summary-card__value">{{isPaired ? '双人空间' : '单人空间'}}</view>
        <view class="profile-summary-card__desc">{{pairInfo && pairInfo.invite_code ? ('邀请码：' + pairInfo.invite_code) : '还未建立共同关系档案'}}</view>
      </view>
      <view class="profile-summary-card" wx:if="{{assessmentLatest}}">
        <view class="profile-summary-card__label">最新体检</view>
        <view class="profile-summary-card__value">{{assessmentLatest.totalScore}}</view>
        <view class="profile-summary-card__desc">{{assessmentLatest.levelLabel}}</view>
      </view>
      <view class="profile-summary-card" wx:if="{{privacyStatus}}">
        <view class="profile-summary-card__label">隐私状态</view>
        <view class="profile-summary-card__value">{{privacyStatus.sandbox_enabled ? '沙盒已开' : '常规模式'}}</view>
        <view class="profile-summary-card__desc">{{privacyStatus.deletion_request_pending ? '存在删除请求待处理' : '当前无删除请求'}}</view>
      </view>
    </view>
  </view>

  <view class="section-group">
    <view class="section-group__title">常用入口</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="openPage" data-path="/pages/report/report">
        <view class="menu-item__left">
          <view class="menu-item__icon">📊</view>
          <view class="menu-item__text">
            <view class="menu-item__title">关系报告</view>
            <view class="menu-item__desc">查看最新判断、趋势与边界提醒</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
      <view class="menu-item" bindtap="openPage" data-path="/pages/discover/health-test/health-test">
        <view class="menu-item__left">
          <view class="menu-item__icon">🩺</view>
          <view class="menu-item__text">
            <view class="menu-item__title">关系体检</view>
            <view class="menu-item__desc">正式提交本周评估</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
      <view class="menu-item" bindtap="openPage" data-path="/pages/timeline/timeline">
        <view class="menu-item__left">
          <view class="menu-item__icon">🕒</view>
          <view class="menu-item__text">
            <view class="menu-item__title">时间轴</view>
            <view class="menu-item__desc">回看记录、体检与报告如何关联</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
      <view class="menu-item" bindtap="openPage" data-path="/pages/privacy/privacy">
        <view class="menu-item__left">
          <view class="menu-item__icon">🔒</view>
          <view class="menu-item__text">
            <view class="menu-item__title">隐私中心</view>
            <view class="menu-item__desc">管理权限、删除请求与边界设置</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
    </view>
  </view>

  <view class="section-group">
    <view class="section-group__title">账号与设置</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="editName">
        <view class="menu-item__left">
          <view class="menu-item__icon">👤</view>
          <view class="menu-item__text">
            <view class="menu-item__title">修改昵称</view>
            <view class="menu-item__desc">同步更新你的展示名称</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
      <view class="menu-item" bindtap="changePassword">
        <view class="menu-item__left">
          <view class="menu-item__icon">🔑</view>
          <view class="menu-item__text">
            <view class="menu-item__title">修改密码</view>
            <view class="menu-item__desc">建议在更完整的端上完成</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
      <view class="menu-item" bindtap="openPage" data-path="/pages/pair/pair">
        <view class="menu-item__left">
          <view class="menu-item__icon">🔗</view>
          <view class="menu-item__text">
            <view class="menu-item__title">配对管理</view>
            <view class="menu-item__desc">管理邀请关系与双人空间状态</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-item__left">
          <view class="menu-item__icon">ℹ️</view>
          <view class="menu-item__text">
            <view class="menu-item__title">关于亲健</view>
            <view class="menu-item__desc">查看版本信息与产品定位</view>
          </view>
        </view>
        <view class="menu-item__arrow">›</view>
      </view>
    </view>
  </view>

  <view class="section-group">
    <view class="logout-btn" bindtap="handleLogout">退出登录</view>
  </view>

  <view class="copyright">亲健 · 青年亲密关系健康支持系统</view>
</view>
