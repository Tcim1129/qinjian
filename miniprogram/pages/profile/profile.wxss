.profile-page {
  padding-top: 24rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(150deg, rgba(18, 40, 78, 0.96), rgba(39, 72, 126, 0.92));
  box-shadow: 0 24rpx 52rpx rgba(20, 37, 69, 0.2);
}

.profile-hero__orb {
  position: absolute;
  top: -50rpx;
  right: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(122, 160, 143, 0.22);
}

.profile-hero__content,
.profile-summary-grid {
  position: relative;
  z-index: 1;
}

.profile-hero__content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.profile-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(245, 247, 252, 0.72);
}

.profile-status {
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.profile-status.paired {
  background: rgba(46, 139, 114, 0.22);
  color: #C8F0E4;
}

.profile-status.single {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.78);
}

.profile-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 26rpx;
}

.profile-summary-card {
  min-height: 170rpx;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.profile-summary-card__label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(245, 247, 252, 0.6);
}

.profile-summary-card__value {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.profile-summary-card__desc {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: rgba(245, 247, 252, 0.72);
}

.section-group {
  margin-top: 24rpx;
}

.section-group__title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-list {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 26rpx;
  border: 1rpx solid rgba(25, 34, 52, 0.08);
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(26, 36, 54, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid rgba(25, 34, 52, 0.08);
}

.menu-item__left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.menu-item__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(33, 75, 143, 0.08), rgba(216, 142, 82, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.menu-item__text {
  min-width: 0;
}

.menu-item__title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
}

.menu-item__desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.6;
}

.menu-item__arrow {
  font-size: 32rpx;
  color: #B4BCCB;
  flex-shrink: 0;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-danger);
  border: 1rpx solid rgba(217, 92, 92, 0.18);
}

.copyright {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-muted);
  padding: 28rpx 0 48rpx;
}
