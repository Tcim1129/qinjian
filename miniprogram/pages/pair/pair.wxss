.pair-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.pair-shell {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.loading-wrap {
  min-height: 72vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  width: 100%;
  padding: 48rpx 40rpx;
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
}

.loading-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 40rpx 34rpx;
  box-shadow: 0 24rpx 56rpx rgba(18, 30, 53, 0.18);
}

.hero-card--dark {
  background:
    radial-gradient(circle at top right, rgba(231, 195, 158, 0.22), transparent 34%),
    linear-gradient(155deg, #17243b 0%, #214B8F 52%, #4E78BC 100%);
  color: #ffffff;
}

.hero-badge,
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-badge {
  width: fit-content;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 42rpx;
  line-height: 1.32;
  font-weight: 800;
  letter-spacing: 0.4rpx;
}

.hero-copy {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.82);
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}

.hero-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.section-card {
  padding: 34rpx 32rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.section-head--standalone {
  margin-bottom: 22rpx;
}

.section-eyebrow {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--color-primary);
  text-transform: uppercase;
}

.section-eyebrow--danger {
  color: var(--color-danger);
}

.section-title {
  margin-top: 8rpx;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text);
}

.section-note {
  max-width: 220rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--color-text-muted);
  text-align: right;
}

.invite-panel,
.empty-invite,
.join-panel {
  display: flex;
  flex-direction: column;
}

.invite-panel {
  gap: 18rpx;
}

.invite-caption {
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.invite-code-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(33, 75, 143, 0.07), rgba(255, 255, 255, 0.95));
  border: 1rpx solid rgba(33, 75, 143, 0.08);
}

.invite-code-block--paired {
  margin-top: 8rpx;
}

.invite-code {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--color-primary);
  font-family: "Courier New", monospace;
}

.invite-helper {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.invite-actions {
  margin-top: 22rpx;
}

.empty-invite {
  align-items: center;
  text-align: center;
}

.empty-orb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  box-shadow: 0 18rpx 36rpx rgba(33, 75, 143, 0.22);
}

.empty-title {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.empty-copy {
  margin: 14rpx 0 28rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.join-panel {
  gap: 22rpx;
}

.join-input-wrap {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(25, 34, 52, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

.join-input {
  width: 100%;
  font-size: 27rpx;
  color: var(--color-text);
}

.join-btn {
  box-shadow: none;
}

.join-btn.active {
  box-shadow: 0 16rpx 32rpx rgba(216, 142, 82, 0.22);
}

.capability-block {
  margin-top: 4rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.feature-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 28rpx 18rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(25, 34, 52, 0.06);
  box-shadow: 0 12rpx 26rpx rgba(21, 31, 53, 0.05);
}

.feature-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-symbol {
  font-size: 38rpx;
}

.feature-name {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-text);
}

.notice-card {
  overflow: hidden;
}

.notice-swiper {
  height: 92rpx;
}

.notice-line {
  height: 92rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.notice-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--color-secondary);
  flex-shrink: 0;
}

.notice-text {
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.status-pill {
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.9);
}

.partner-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 26rpx 0 24rpx;
}

.partner-avatar {
  width: 106rpx;
  height: 106rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.14);
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  flex-shrink: 0;
}

.partner-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.partner-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.partner-account {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

.partner-copy {
  font-size: 24rpx;
  line-height: 1.72;
  color: rgba(255, 255, 255, 0.84);
}

.hero-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.74);
}

.hero-btn {
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.metric-card {
  margin-bottom: 0;
  text-align: center;
  padding: 34rpx 24rpx;
}

.metric-value {
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 800;
  color: var(--color-primary);
}

.metric-label {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.pair-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.pair-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(25, 34, 52, 0.06);
}

.pair-item-main {
  flex: 1;
}

.pair-item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.pair-item-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.danger-card {
  border: 1rpx solid rgba(217, 92, 92, 0.18);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 240, 240, 0.95));
}

.danger-copy {
  font-size: 24rpx;
  line-height: 1.72;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

.danger-btn {
  color: var(--color-danger);
  border-color: rgba(217, 92, 92, 0.24);
}

.modal {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(13, 19, 31, 0.48);
  backdrop-filter: blur(6rpx);
}

.modal-content {
  position: relative;
  width: 84%;
  max-width: 620rpx;
  padding: 34rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 26rpx 60rpx rgba(18, 30, 53, 0.16);
  z-index: 1001;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text);
}

.modal-close {
  font-size: 42rpx;
  line-height: 1;
  color: var(--color-text-secondary);
  padding: 0 6rpx;
}

.modal-body {
  margin-bottom: 30rpx;
}

.modal-footer {
  display: flex;
  gap: 18rpx;
}

.modal-footer .btn {
  flex: 1;
}

.text-muted {
  color: var(--color-text-secondary);
}

@media (max-width: 360px) {
  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero-footer,
  .pair-item,
  .invite-code-block {
    flex-direction: column;
    align-items: stretch;
  }

  .section-note {
    max-width: none;
    text-align: left;
  }
}
