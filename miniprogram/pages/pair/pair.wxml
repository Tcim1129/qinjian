<!-- 配对管理页 -->
<view class="container container-safe pair-page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-card card-creamy">
      <text class="loading-title">正在同步双人空间</text>
      <text class="loading-text">把配对状态、邀请关系和共同主线一起拉取回来。</text>
    </view>
  </view>

  <block wx:else>
    <view wx:if="{{!isPaired}}" class="pair-shell animate-fade-in">
      <view class="hero-card hero-card--dark">
        <view class="hero-badge">双人空间</view>
        <view class="hero-title">先建立共同主线，再让记录、体检、报告和时间轴说同一种上下文。</view>
        <view class="hero-copy">配对后，双方的记录会进入同一段关系档案，AI 才能基于真实上下文给出更稳妥的判断与修复建议。</view>
        <view class="hero-chips">
          <view class="hero-chip">私密共享</view>
          <view class="hero-chip">关系主线</view>
          <view class="hero-chip">AI 支持</view>
        </view>
      </view>

      <view class="card-creamy section-card">
        <view class="section-head">
          <view>
            <view class="section-eyebrow">第一步</view>
            <view class="section-title">生成或查看你的邀请代码</view>
          </view>
        </view>

        <block wx:if="{{hasInviteDraft}}">
          <view class="invite-panel">
            <text class="invite-caption">当前可分享的邀请码</text>
            <view class="invite-code-block">
              <text class="invite-code">{{inviteCodeDisplay}}</text>
              <button class="btn btn-secondary btn-small" bindtap="copyInviteCode">复制</button>
            </view>
            <text class="invite-helper">把这串代码发给对方，对方输入后即可进入同一段关系主线。</text>
          </view>
          <view class="invite-actions">
            <button open-type="share" class="btn btn-primary btn-block">邀请对方进入双人空间</button>
          </view>
        </block>

        <block wx:else>
          <view class="empty-invite">
            <view class="empty-orb">❤</view>
            <view class="empty-title">还没有生成邀请码</view>
            <view class="empty-copy">先创建一个情侣空间，再把邀请码发给对方。系统会把后续的记录、体检和报告串成一条共同主线。</view>
            <button class="btn btn-primary btn-block" bindtap="createPair" loading="{{creating}}" disabled="{{creating}}">
              {{creating ? '生成中...' : '创建双人空间'}}
            </button>
          </view>
        </block>
      </view>

      <view class="card-creamy section-card">
        <view class="section-head">
          <view>
            <view class="section-eyebrow">第二步</view>
            <view class="section-title">输入对方的邀请码</view>
          </view>
          <text class="section-note">也可以直接加入对方已经创建好的空间。</text>
        </view>
        <view class="join-panel">
          <view class="join-input-wrap">
            <input
              class="join-input"
              placeholder="输入对方提供的 6-12 位配对码"
              placeholder-style="color: #8E97A8;"
              value="{{inviteCode}}"
              bindinput="onInviteCodeInput"
              maxlength="12"
            />
          </view>
          <button class="btn btn-accent btn-block join-btn {{bindBtnClass}}" bindtap="joinPair" loading="{{joining}}" disabled="{{joining}}">
            {{joinBtnText}}
          </button>
        </view>
      </view>

      <view class="capability-block">
        <view class="section-head section-head--standalone">
          <view>
            <view class="section-eyebrow">配对后可用</view>
            <view class="section-title">双人空间会承接的核心能力</view>
          </view>
        </view>
        <view class="feature-grid">
          <view class="feature-card" wx:for="{{featureIcons}}" wx:key="name">
            <view class="feature-icon" style="background: {{item.bg}};">
              <text class="feature-symbol">{{item.icon}}</text>
            </view>
            <text class="feature-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="notice-card card-creamy">
        <view class="section-head">
          <view>
            <view class="section-eyebrow">使用说明</view>
            <view class="section-title">建立配对后会发生什么</view>
          </view>
        </view>
        <swiper class="notice-swiper" vertical autoplay circular interval="3200">
          <swiper-item wx:for="{{notices}}" wx:key="*this">
            <view class="notice-line">
              <view class="notice-dot"></view>
              <text class="notice-text">{{item}}</text>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <view wx:else class="pair-shell animate-fade-in">
      <view class="hero-card hero-card--dark">
        <view class="hero-topline">
          <view class="hero-badge">已配对</view>
          <view class="status-pill">{{pairTypeText}}</view>
        </view>
        <view class="partner-row">
          <view class="partner-avatar">{{partnerInitial}}</view>
          <view class="partner-meta">
            <view class="partner-name">{{partnerDisplay}}</view>
            <view class="partner-account" wx:if="{{hasPartnerContact}}">{{partnerContact}}</view>
            <view class="partner-copy">共同记录、周体检、关系报告与时间轴，都会默认进入这段关系主线。</view>
          </view>
        </view>
        <view class="hero-footer">
          <text class="hero-footer-text">配对建立时间：{{pairCreatedAt}}</text>
          <button wx:if="{{hasPartnerId}}" class="btn btn-secondary btn-small hero-btn" bindtap="showSetNicknameModal">设置备注名</button>
        </view>
      </view>

      <view class="stats-grid">
        <view class="metric-card card-creamy">
          <view class="metric-value">{{checkinDays}}</view>
          <view class="metric-label">共同记录天数</view>
        </view>
        <view class="metric-card card-creamy">
          <view class="metric-value">{{relationshipDays}}</view>
          <view class="metric-label">关系持续天数</view>
        </view>
      </view>

      <view wx:if="{{hasInviteCode}}" class="card-creamy section-card">
        <view class="section-head">
          <view>
            <view class="section-eyebrow">关系入口</view>
            <view class="section-title">当前邀请码</view>
          </view>
        </view>
        <view class="invite-code-block invite-code-block--paired">
          <text class="invite-code">{{pairInfo.invite_code}}</text>
          <button class="btn btn-secondary btn-small" bindtap="copyInviteCode">复制</button>
        </view>
      </view>

      <view wx:if="{{pairList.length > 0}}" class="card-creamy section-card">
        <view class="section-head">
          <view>
            <view class="section-eyebrow">配对管理</view>
            <view class="section-title">我的配对列表</view>
          </view>
          <text class="section-note">可切换当前激活的关系主线。</text>
        </view>
        <view class="pair-list">
          <view class="pair-item" wx:for="{{pairList}}" wx:key="id">
            <view class="pair-item-main">
              <view class="pair-item-name">{{item.partnerDisplayName}}</view>
              <view class="pair-item-meta">{{item.typeText}} · {{item.statusText}}</view>
            </view>
            <button class="btn btn-secondary btn-small" bindtap="setCurrentPair" data-pair="{{item}}">设为当前</button>
          </view>
        </view>
      </view>

      <view class="card-creamy section-card">
        <view class="section-head">
          <view>
            <view class="section-eyebrow">扩展入口</view>
            <view class="section-title">加入新的配对</view>
          </view>
          <text class="section-note">如果你管理多段关系档案，可继续接入新的邀请码。</text>
        </view>
        <view class="join-panel">
          <view class="join-input-wrap">
            <input
              class="join-input"
              type="text"
              placeholder="请输入新的配对码"
              placeholder-style="color: #8E97A8;"
              value="{{inviteCode}}"
              bindinput="onInviteCodeInput"
            />
          </view>
          <button class="btn btn-accent btn-block join-btn {{bindBtnClass}}" bindtap="joinPair" loading="{{joining}}" disabled="{{joining}}">
            {{joinBtnText}}
          </button>
        </view>
      </view>

      <view class="danger-card card-creamy">
        <view class="section-head">
          <view>
            <view class="section-eyebrow section-eyebrow--danger">风险操作</view>
            <view class="section-title">解除当前配对</view>
          </view>
        </view>
        <view class="danger-copy">解除后会发起解绑请求，对方确认后生效；如已存在解绑请求，系统会按当前规则继续处理。</view>
        <button class="btn btn-outline btn-block danger-btn" bindtap="handleUnbind">发起解绑</button>
      </view>
    </view>
  </block>

  <view class="modal" wx:if="{{showNicknameModal}}">
    <view class="modal-mask" bindtap="hideNicknameModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-title">设置伴侣备注名</view>
        <text class="modal-close" bindtap="hideNicknameModal">×</text>
      </view>
      <view class="modal-body">
        <view class="input-wrap mb-md">
          <input
            placeholder="给伴侣起个备注名"
            value="{{customNicknameInput}}"
            bindinput="onNicknameInput"
            maxlength="20"
          />
        </view>
        <view class="text-small text-muted">设置后，首页、报告和配对页都会优先显示这个名称。</view>
      </view>
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="hideNicknameModal">取消</button>
        <button class="btn btn-primary" bindtap="saveCustomNickname">保存</button>
      </view>
    </view>
  </view>
</view>
