# 亲健 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# 永远不要将 .env 文件提交到 Git。

# === 数据库配置 ===
DB_PASSWORD=your_secure_password_here
FRONTEND_ORIGIN=https://your-domain.com
APP_TIMEZONE=Asia/Shanghai

# === 应用密钥 ===
# 用于 JWT 签名，请使用随机生成的长字符串
SECRET_KEY=your_random_secret_key_min_32_chars

# === 大模型 OpenAI 兼容 API ===
# 从 https://siliconflow.cn 获取
SILICONFLOW_API_KEY=<SILICONFLOW_API_KEY>

# === 通用 OpenAI 兼容模型网关（可选，用它时可不填 SiliconFlow）===
# 必须自己填写真实 Key，仓库不再内置任何默认密钥
AI_API_KEY=<在此填写你的AI_API_KEY>
AI_BASE_URL=https://llm-ipplpz10dpd82u07.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENT_SESSION_TTL_HOURS=12
AGENT_CHAT_HISTORY_LIMIT=8
ASR_PROVIDER=qwen3
OPENAI_COMPATIBLE_ASR_MODEL=whisper-1
REALTIME_ASR_PROVIDER=qwen3
REALTIME_ASR_TICKET_EXPIRE_SECONDS=120
REALTIME_ASR_MAX_SESSION_SECONDS=60
REALTIME_ASR_STOP_TIMEOUT_SECONDS=20

# === 微信小程序（可选）===
# 如需微信登录功能，从微信小程序后台获取
WECHAT_APPID=wx_optional_your_appid
WECHAT_SECRET=optional_your_secret

# === AI 模型配置（可选，使用默认值即可）===
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
AI_MULTIMODAL_MODEL=qwen3.7-plus-2026-05-26
AI_MULTIMODAL_FALLBACK_MODEL=qwen3.7-plus
AI_TEXT_MODEL=deepseek-v4.1-flash
AI_TEXT_FALLBACK_MODEL=deepseek-v4.1-flash

# === Qwen3 ASR（百炼 / DashScope）===
QWEN_ASR_API_KEY=
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_FILE_MODEL=qwen3-asr-flash
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime

# === 手机验证码与登录风控存储（生产建议 Redis）===
PHONE_CODE_STORE=redis
REDIS_URL=redis://redis:6379/0
PHONE_CODE_REDIS_PREFIX=qinjian:phone-code:
REQUEST_COOLDOWN_REDIS_PREFIX=qinjian:request-cooldown:
REQUEST_COOLDOWN_REDIS_TIMEOUT_SECONDS=0.5

# === 演示模式（默认关闭，生产环境不建议开启）===
# 开启后可通过 Bearer demo-mode 字面量令牌进入内置演示账号。
# 仅在路演/演示/临时展示环境设为 true，正式环境保持 false。
ALLOW_DEMO_AGENT=false
