#!/usr/bin/expect -f

set timeout 60
proc required_value {index env_name description} {
    global argv
    if {[llength $argv] > $index} {
        set value [string trim [lindex $argv $index]]
        if {$value ne ""} {
            return $value
        }
    }
    if {[info exists ::env($env_name)]} {
        set value [string trim $::env($env_name)]
        if {$value ne ""} {
            return $value
        }
    }
    puts stderr "缺少${description}，请通过命令行参数或环境变量 ${env_name} 提供。"
    exit 1
}

set host [required_value 0 "QJ_REMOTE_HOST" "远端主机"]
set username [required_value 1 "QJ_REMOTE_USER" "远端用户名"]
set password [required_value 2 "QJ_REMOTE_PASSWORD" "远端密码"]
set remote_root [required_value 3 "QJ_REMOTE_ROOT" "远端部署目录"]
set strict_host_key_checking [string trim [expr {[info exists ::env(QJ_STRICT_HOST_KEY_CHECKING)] ? $::env(QJ_STRICT_HOST_KEY_CHECKING) : "accept-new"}]]

spawn ssh -o StrictHostKeyChecking=$strict_host_key_checking $username@$host

expect "password:"
send "$password\r"

expect "#"
send "cd $remote_root\r"

expect "#"
send "echo '[1/5] 拉取最新代码...'\r"
send "git pull origin main\r"

expect "#"
send "echo '[2/5] 停止现有服务...'\r"
send "docker-compose down 2>/dev/null || true\r"

expect "#"
send "echo '[3/5] 构建并启动服务...'\r"
send "docker-compose up -d --build\r"

expect "#"
send "echo '[4/5] 等待服务启动...'\r"
send "sleep 15\r"

expect "#"
send "echo '[5/5] 检查服务状态...'\r"
send "docker-compose ps\r"

expect "#"
send "echo '✅ 部署完成！'\r"
send "echo '部署目标: $host'\r"
send "exit\r"

interact
